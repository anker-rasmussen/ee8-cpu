      <a name="text" val="4-BIT PC REGISTER"/>
    </comp>
    <comp lib="7" loc="(270,295)" name="Text">
      <a name="font" val="SansSerif bold 10"/>
      <a name="text" val="BRANCH LOGIC"/>
    </comp>
    <comp lib="7" loc="(280,310)" name="Text">
      <a name="font" val="SansSerif plain 9"/>
      <a name="text" val="JZ(cond=0): taken when zero=1 → XOR=1"/>
    </comp>
    <comp lib="7" loc="(280,325)" name="Text">
      <a name="font" val="SansSerif plain 9"/>
      <a name="text" val="JNZ(cond=1): taken when zero=0 → XOR=1"/>
    </comp>
    <comp lib="7" loc="(280,335)" name="Text">
      <a name="font" val="SansSerif plain 9"/>
      <a name="text" val="branch_taken = branch_cond XOR rcond_is_zero"/>
    </comp>
    <comp lib="7" loc="(410,20)" name="Text">
      <a name="text" val="PROGRAM COUNTER (v4.0 — 4-bit, Rcond branch)"/>
    </comp>
    <comp lib="7" loc="(425,210)" name="Text">
      <a name="font" val="SansSerif bold 10"/>
      <a name="text" val="jump_addr[3:0] from decoder"/>
    </comp>
    <comp lib="7" loc="(425,285)" name="Text">
      <a name="font" val="SansSerif plain 9"/>
      <a name="text" val="take_jump = jump OR cond_jump"/>
    </comp>
    <comp lib="7" loc="(430,370)" name="Text">
      <a name="font" val="SansSerif plain 9"/>
      <a name="text" val="cond_jump = branch AND branch_taken"/>
    </comp>
    <comp lib="7" loc="(445,105)" name="Text">
      <a name="font" val="SansSerif bold 10"/>
      <a name="text" val="PC + 1"/>
    </comp>
    <comp lib="7" loc="(570,135)" name="Text">
      <a name="font" val="SansSerif bold 10"/>
      <a name="text" val="NEXT PC MUX (4-bit)"/>
    </comp>
    <comp lib="7" loc="(575,140)" name="Text">
      <a name="font" val="SansSerif plain 9"/>
      <a name="text" val="0=PC+1, 1=jump_addr[3:0]"/>
    </comp>
    <comp lib="7" loc="(60,360)" name="Text">
      <a name="font" val="SansSerif plain 9"/>
      <a name="text" val="0=JZ, 1=JNZ"/>
    </comp>
    <comp lib="7" loc="(70,560)" name="Text">
      <a name="font" val="SansSerif plain 9"/>
      <a name="text" val="Compare rcond_val vs 0x00"/>
    </comp>
    <comp lib="7" loc="(705,40)" name="Text">
      <a name="font" val="SansSerif bold 10"/>
      <a name="text" val="OUTPUT: pc_out[3:0]"/>
    </comp>
    <comp lib="7" loc="(730,220)" name="Text">
      <a name="font" val="SansSerif bold 10"/>
      <a name="text" val="LOGIC:"/>
    </comp>
    <comp lib="7" loc="(730,240)" name="Text">
      <a name="font" val="SansSerif plain 9"/>
      <a name="text" val="rcond_is_zero = (rcond_val == 0x00)       [comparator]"/>
    </comp>
    <comp lib="7" loc="(730,255)" name="Text">
      <a name="font" val="SansSerif plain 9"/>
      <a name="text" val="branch_taken  = branch_cond XOR rcond_is_zero"/>
    </comp>
    <comp lib="7" loc="(730,270)" name="Text">
      <a name="font" val="SansSerif plain 9"/>
      <a name="text" val="cond_jump     = branch AND branch_taken"/>
    </comp>
    <comp lib="7" loc="(730,285)" name="Text">
      <a name="font" val="SansSerif plain 9"/>
      <a name="text" val="take_jump     = jump OR cond_jump"/>
    </comp>
    <comp lib="7" loc="(730,300)" name="Text">
      <a name="font" val="SansSerif plain 9"/>
      <a name="text" val="next_pc       = take_jump ? jump_addr : pc + 1  [MUX]"/>
    </comp>
    <comp lib="7" loc="(730,315)" name="Text">
      <a name="font" val="SansSerif plain 9"/>
      <a name="text" val="pc_reg.we     = NOT(halt)"/>
    </comp>
    <comp lib="7" loc="(730,330)" name="Text">
      <a name="font" val="SansSerif plain 9"/>
      <a name="text" val="pc_out        = pc_reg.Q"/>
    </comp>
