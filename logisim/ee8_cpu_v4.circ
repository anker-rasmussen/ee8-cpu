      <a name="font" val="SansSerif bold 10"/>
      <a name="text" val="EXTERNAL OUTPUTS:"/>
    </comp>
    <comp lib="7" loc="(2080,1090)" name="Text">
      <a name="font" val="SansSerif plain 10"/>
      <a name="text" val="DECODE.opcode[3:0] -&gt; IO_DEC.opcode (for reserved opcode 1110 detect)"/>
    </comp>
    <comp lib="7" loc="(2080,1165)" name="Text">
      <a name="font" val="SansSerif plain 10"/>
      <a name="text" val="IO_DEC.is_in -&gt; io_read pin (for external ITEM_PULSE latch clear)"/>
    </comp>
    <comp lib="7" loc="(2085,1000)" name="Text">
      <a name="font" val="SansSerif plain 10"/>
      <a name="text" val="REGS.rs1_out[7:0] -&gt; PC.rcond_val[7:0]  (Rcond = rs1 field = any register)"/>
    </comp>
    <comp lib="7" loc="(2090,1010)" name="Text">
      <a name="font" val="SansSerif plain 10"/>
      <a name="text" val="CTRL.halt -&gt; PC.halt AND halt_out pin"/>
    </comp>
    <comp lib="7" loc="(2110,160)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="text" val="Single-cycle: FETCH -&gt; DECODE -&gt; EXECUTE -&gt; WRITEBACK (one clock)"/>
    </comp>
    <comp lib="7" loc="(2130,465)" name="Text">
      <a name="font" val="SansSerif plain 10"/>
      <a name="text" val="  01 (LDI):    DECODE.rs1[1:0] -&gt; REGS.sel_rd (I-type Rd is at rs1 position [11:10])"/>
    </comp>
    <comp lib="7" loc="(2135,135)" name="Text">
      <a name="text" val="=== DATAPATH (v4.0) ==="/>
    </comp>
    <comp lib="7" loc="(2135,185)" name="Text">
      <a name="font" val="SansSerif bold 10"/>
      <a name="text" val="EXECUTE LOGIC:"/>
    </comp>
    <comp lib="7" loc="(2135,205)" name="Text">
      <a name="font" val="SansSerif plain 10"/>
      <a name="text" val="ALU_A       = imm_sel ? immediate[7:0] : rs1_out[7:0]"/>
    </comp>
    <comp lib="7" loc="(2135,220)" name="Text">
      <a name="font" val="SansSerif plain 10"/>
      <a name="text" val="ALU_B       = rs2_out[7:0]"/>
    </comp>
    <comp lib="7" loc="(2135,235)" name="Text">
      <a name="font" val="SansSerif plain 10"/>
      <a name="text" val="alu_result  = ALU(ALU_A, ALU_B, alu_op)"/>
    </comp>
    <comp lib="7" loc="(2135,260)" name="Text">
      <a name="font" val="SansSerif bold 10"/>
      <a name="text" val="WRITEBACK LOGIC:"/>
    </comp>
    <comp lib="7" loc="(2135,280)" name="Text">
      <a name="font" val="SansSerif plain 10"/>
      <a name="text" val="data_in     = is_in ? input_port : alu_result"/>
    </comp>
    <comp lib="7" loc="(2135,295)" name="Text">
      <a name="font" val="SansSerif plain 10"/>
      <a name="text" val="rd_sel      = {flag_write, imm_sel}: 00=rd[7:6], 01=rs1[11:10](LDI), 10=R3(LT/EQ)"/>
    </comp>
    <comp lib="7" loc="(2135,310)" name="Text">
      <a name="font" val="SansSerif plain 10"/>
      <a name="text" val="reg_we      = reg_write AND NOT(is_out)"/>
    </comp>
    <comp lib="7" loc="(2135,335)" name="Text">
      <a name="font" val="SansSerif bold 10"/>
      <a name="text" val="I/O (Option B — opcode 0111 overloaded):"/>
    </comp>
    <comp lib="7" loc="(2135,355)" name="Text">
      <a name="font" val="SansSerif plain 10"/>
      <a name="text" val="IO_DEC decodes rs2: 00=MOV, 10=OUT, 11=IN, 01=SYS_ERR"/>
    </comp>
    <comp lib="7" loc="(2135,370)" name="Text">
      <a name="font" val="SansSerif plain 10"/>
      <a name="text" val="OUT: output_port_reg latches rs1_out on is_out"/>
    </comp>
    <comp lib="7" loc="(2135,385)" name="Text">
      <a name="font" val="SansSerif plain 10"/>
      <a name="text" val="IN:  input_port routed to reg file via writeback MUX on is_in"/>
    </comp>
    <comp lib="7" loc="(2135,400)" name="Text">
      <a name="font" val="SansSerif plain 10"/>
      <a name="text" val="sys_err = io_err OR (opcode == 0xE)"/>
    </comp>
    <comp lib="7" loc="(2135,425)" name="Text">
      <a name="font" val="SansSerif bold 10"/>
      <a name="text" val="DEBUG PINS:"/>
    </comp>
    <comp lib="7" loc="(2135,445)" name="Text">
      <a name="font" val="SansSerif plain 10"/>
      <a name="text" val="pc_out, r2_debug, io_read, halt_out, sys_err_out — exposed for test bench"/>
    </comp>
    <comp lib="7" loc="(420,85)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="PC"/>
    </comp>
    <comp lib="7" loc="(440,390)" name="Text">
      <a name="font" val="SansSerif bold 10"/>
      <a name="text" val="RD_SEL MUX (2-bit sel)"/>
    </comp>
    <comp lib="7" loc="(510,475)" name="Text">
      <a name="font" val="SansSerif plain 9"/>
      <a name="text" val="sel[0]=imm_sel, sel[1]=flag_write"/>
    </comp>
    <comp lib="7" loc="(535,495)" name="Text">
      <a name="font" val="SansSerif plain 9"/>
      <a name="text" val="00=rd, 01=rs1(LDI dest), 10=R3(11), 11=unused"/>
    </comp>
    <comp lib="7" loc="(680,30)" name="Text">
      <a name="font" val="SansSerif bold 18"/>
      <a name="text" val="EE8 CPU v4.0 — TOP LEVEL INTEGRATION"/>
    </comp>
    <comp lib="7" loc="(680,55)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Single-cycle RISC datapath. I/O Option B (IN/OUT instructions)."/>
    </comp>
    <comp lib="7" loc="(710,475)" name="Text">
      <a name="font" val="SansSerif bold 10"/>
      <a name="text" val="WRITEBACK MUX (sel=is_in)"/>
    </comp>
    <comp lib="7" loc="(715,500)" name="Text">
      <a name="font" val="SansSerif plain 9"/>
      <a name="text" val="0=ALU result, 1=input_port"/>
