    <comp lib="7" loc="(200,520)" name="Text">
      <a name="font" val="SansSerif plain 9"/>
      <a name="text" val="is_mov_sel = NOT(rs2[1]) AND NOT(rs2[0])   → AND mov_group → is_mov"/>
    </comp>
    <comp lib="7" loc="(200,535)" name="Text">
      <a name="font" val="SansSerif plain 9"/>
      <a name="text" val="is_in_sel  = rs2[1] AND rs2[0]             → AND mov_group → is_in"/>
    </comp>
    <comp lib="7" loc="(200,550)" name="Text">
      <a name="font" val="SansSerif plain 9"/>
      <a name="text" val="is_out_sel = rs2[1] AND NOT(rs2[0])        → AND mov_group → is_out"/>
    </comp>
    <comp lib="7" loc="(200,565)" name="Text">
      <a name="font" val="SansSerif plain 9"/>
      <a name="text" val="is_err_sel = NOT(rs2[1]) AND rs2[0]        → AND mov_group → io_err"/>
    </comp>
    <comp lib="7" loc="(200,585)" name="Text">
      <a name="font" val="SansSerif plain 9"/>
      <a name="text" val="sys_err = io_err OR (opcode == 0xE)"/>
    </comp>
