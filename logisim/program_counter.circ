    <a name="clabelfont" val="SansSerif plain 12"/>

    <comp lib="6" loc="(400,50)" name="Text">
      <a name="text" val="EE8 PROGRAM COUNTER"/>
      <a name="font" val="SansSerif bold 20"/>
    </comp>
    <comp lib="6" loc="(400,70)" name="Text">
      <a name="text" val="4-bit counter with JMP and RST"/>
